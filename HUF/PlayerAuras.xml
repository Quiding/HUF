<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
    <!-- HUF's buff / debuff bars: one icon. The game's secure aura header
         makes these and hands each its aura ("index") or weapon enchant
         ("target-slot"); right-click cancels a buff, also in combat. -->
    <Button name="HUFAuraButtonTemplate" inherits="SecureActionButtonTemplate" virtual="true">
        <Size x="32" y="32"/>
        <Attributes>
            <Attribute name="type2" value="cancelaura"/>
            <Attribute name="unit" value="player"/>
        </Attributes>
        <Scripts>
            <OnLoad>
                if HUF_AuraButton_OnLoad then HUF_AuraButton_OnLoad(self) end
            </OnLoad>
        </Scripts>
    </Button>
</Ui>
